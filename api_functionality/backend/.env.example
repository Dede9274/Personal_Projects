POSTGRES_USER=uptime_user
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=uptime_monitor
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://uptime_user:replace_with_a_strong_password@localhost:5433/uptime_monitor

# Browser origins allowed to call FastAPI directly
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Private SMTP transport. Enable email and choose recipients in the dashboard.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Optional webhook credentials. Configure the URL in the dashboard.
WEBHOOK_BEARER_TOKEN=
WEBHOOK_SIGNING_SECRET=
