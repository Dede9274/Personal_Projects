POSTGRES_USER=uptime_user
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=uptime_monitor
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://uptime_user:replace_with_a_strong_password@localhost:5433/uptime_monitor

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Email incident notifications
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=uptime@example.com
ALERT_EMAIL_TO=owner@example.com
SMTP_TIMEOUT_SECONDS=10

# Generic JSON webhook incident notifications
WEBHOOK_NOTIFICATIONS_ENABLED=false
ALERT_WEBHOOK_URL=https://example.com/webhooks/uptime
WEBHOOK_BEARER_TOKEN=
WEBHOOK_SIGNING_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10
