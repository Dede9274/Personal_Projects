POSTGRES_USER=uptime_user
POSTGRES_PASSWORD=uptime_password
POSTGRES_DB=uptime_monitor
POSTGRES_PORT=5433

REDIS_PORT=6379

# Browser origins allowed to call FastAPI directly.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email incident notifications.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=uptime@example.com
ALERT_EMAIL_TO=owner@example.com
SMTP_TIMEOUT_SECONDS=10

# Generic JSON webhook incident notifications.
WEBHOOK_NOTIFICATIONS_ENABLED=false
ALERT_WEBHOOK_URL=https://example.com/webhooks/uptime
WEBHOOK_BEARER_TOKEN=
WEBHOOK_SIGNING_SECRET=
WEBHOOK_TIMEOUT_SECONDS=10
