            <AnchorPane layoutY="-276.0" prefHeight="414.0" prefWidth="148.0" style="-fx-background-color: #5680E9;">
               <children>
                  <Button fx:id="LogOutbtn" layoutX="43.0" layoutY="346.0" mnemonicParsing="false" onAction="#gotoLogIn" onMouseClicked="#gotoLogIn" style="-fx-background-color: none; -fx-border-color: red;" text="Log Out" textFill="#ef0303">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor></Button>
                  <Label fx:id="ContactusLabel" layoutX="26.0" layoutY="130.0" text="📞    Contact us" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Label>
                  <Label fx:id="mainpageLabel" layoutX="26.0" layoutY="72.0" onMouseClicked="#gotoMainPage" prefHeight="50.0" prefWidth="118.0" text="🏠    Main Page" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Label>
                  <Label fx:id="AboutLabel" layoutX="26.0" layoutY="170.0" text="ℹ️    About" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Label>
                  <Label fx:id="SettingsLabel" layoutX="26.0" layoutY="207.0" text="⚙    Settings" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Label>
                  <Label fx:id="MyappointmentsLabel" layoutX="13.0" layoutY="244.0" onMouseClicked="#gotoMyappointmentsC" text="   🚶   Appointments" textFill="WHITE">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Label>
               </children>
            </AnchorPane>
            <Label layoutX="174.0" layoutY="16.0" text="ID nr." />
