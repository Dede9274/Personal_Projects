               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <ChoiceBox fx:id="timeChooser" layoutX="590.0" layoutY="1.0" prefHeight="26.0" prefWidth="57.0" />
         </children>
      </AnchorPane>
   </bottom>
   <center>
      <AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="142.0" prefWidth="190.0" style="-fx-background-color: lightyellow;" BorderPane.alignment="CENTER">
         <children>
            <TextField fx:id="lastnameTextField" layoutX="14.0" layoutY="55.0">
               <cursor>
                  <Cursor fx:constant="TEXT" />
               </cursor>
            </TextField>
            <TextField fx:id="phonenrTextField" layoutX="14.0" layoutY="102.0">
               <cursor>
                  <Cursor fx:constant="TEXT" />
               </cursor>
            </TextField>
            <TextField fx:id="firstnameTextField" layoutX="14.0" layoutY="8.0" />
            <TextField fx:id="descriptionTextField" layoutX="229.0" layoutY="4.0" prefHeight="102.0" prefWidth="196.0">
               <cursor>
                  <Cursor fx:constant="TEXT" />
               </cursor>
            </TextField>
            <Label layoutX="236.0" layoutY="118.0" text="Choose a date and time" />
         </children>
      </AnchorPane>
   </center>
</BorderPane>
