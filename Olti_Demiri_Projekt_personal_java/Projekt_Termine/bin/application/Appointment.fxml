<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="386.0" prefWidth="687.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.AppointmentController">
   <top>
      <AnchorPane prefHeight="104.0" prefWidth="687.0" style="-fx-background-color: lightyellow;" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="XLabel" layoutX="664.0" layoutY="6.0" text="X" textFill="#ff1111">
               <font>
                  <Font name="Berlin Sans FB" size="14.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Label>
            <Label layoutX="286.0" layoutY="22.0" prefHeight="52.0" prefWidth="276.0" text="Add Appointment" textFill="#5680e9">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <Label layoutX="458.0" layoutY="88.0" text="Reason behind visit" />
         </children>
      </AnchorPane>
   </top>
   <left>
      <AnchorPane prefHeight="200.0" prefWidth="214.0" style="-fx-background-color: lightyellow;" BorderPane.alignment="CENTER">
         <children>
            <Label layoutX="172.0" layoutY="52.0" text="Last Name" />
            <Label layoutX="172.0" layoutY="107.0" text="Phone nr." />
            <Label layoutX="171.0" layoutY="5.0" text="First Name" />
         </children></AnchorPane>
   </left>
   <bottom>
      <AnchorPane prefHeight="138.0" prefWidth="626.0" style="-fx-background-color: lightyellow;" BorderPane.alignment="CENTER">
